# Copy to .env (scripts/ibg.sh does this for you). .env is git-ignored — never commit it.

# Free Gemini key from https://aistudio.google.com/apikey  (leave empty to use the offline rules engine)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest

# Grafana admin password (user: admin). Set it BEFORE the first `scripts/ibg.sh up`: Grafana stores it in its
# volume on first start, so changing it later needs `scripts/ibg.sh destroy` (or a password change in the UI
# plus the same value here).
GRAFANA_ADMIN_PASSWORD=admin

# Where the web UIs are published on the host. 127.0.0.1 = only this machine (recommended).
BIND_ADDR=127.0.0.1
# Host name your BROWSER uses to reach this machine (for links/iframes the engine generates). Keep
# localhost unless you opened the ports to the network (BIND_ADDR=0.0.0.0) and browse from another PC.
PUBLIC_HOST=localhost
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
INTENT_PORT=8088
CADVISOR_PORT=8081
NODE_EXPORTER_PORT=9100
WEBUI_PORT=9999
